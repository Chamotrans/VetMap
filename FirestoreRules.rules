rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function recentClientTimestamp(value) {
      return value is timestamp
        && value <= request.time + duration.value(5, 'm')
        && value >= request.time - duration.value(10, 'm');
    }

    function notFutureTimestamp(value) {
      return value is timestamp
        && value <= request.time + duration.value(5, 'm');
    }

    function validDocumentID(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 200
        && value.matches('^[A-Za-z0-9][A-Za-z0-9._-]*$');
    }

    function validChatUserID(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 100
        && value.matches('^[A-Za-z0-9][A-Za-z0-9._-]*$');
    }

    function allowedSavedCatalogItemIDs() {
      // Canonical IDs from the current HK service catalog and the three
      // official insurance-directory links. Updating the catalog
      // requires updating this allowlist and its CI drift gate together.
      return [
        'hk-service-sup-001',
        'hk-service-sup-002',
        'hk-service-sup-003',
        'hk-service-sup-004',
        'hk-service-sup-005',
        'hk-service-sup-006',
        'hk-service-sup-007',
        'hk-service-sup-008',
        'hk-service-sup-009',
        'hk-service-sup-010',
        'hk-service-sup-011',
        'hk-service-sup-012',
        'hk-service-sup-017',
        'hk-service-sup-019',
        'hk-service-sup-020',
        'hk-service-sup-021',
        'hk-service-sup-022',
        'hk-service-sup-023',
        'hk-service-sup-024',
        'hk-service-sup-025',
        'hk-service-sup-026',
        'hk-service-sup-027',
        'hk-service-sup-028',
        'hk-service-sup-029',
        'hk-service-sup-030',
        'hk-service-sup-031',
        'hk-service-sup-032',
        'hk-service-sup-033',
        'hk-service-sup-041',
        'hk-service-sup-042',
        'hk-service-sup-043',
        'hk-service-sup-044',
        'hk-service-sup-045',
        'hk-service-sup-046',
        'hk-service-sup-047',
        'hk-service-sup-048',
        'hk-service-sup-049',
        'hk-service-sup-050',
        'hk-service-sup-051',
        'hk-service-sup-052',
        'hk-service-sup-053',
        'hk-service-sup-054',
        'hk-service-sup-055',
        'hk-service-sup-056',
        'hk-service-sup-057',
        'hk-service-sup-058',
        'hk-service-sup-059',
        'hk-service-sup-060',
        'hk-service-sup-061',
        'hk-service-sup-062',
        'hk-service-grm-001',
        'hk-service-grm-002',
        'hk-service-grm-003',
        'hk-service-grm-004',
        'hk-service-grm-005',
        'hk-service-grm-006',
        'hk-service-grm-007',
        'hk-service-grm-008',
        'hk-service-grm-009',
        'hk-service-grm-010',
        'hk-service-grm-011',
        'hk-service-grm-012',
        'hk-service-grm-013',
        'hk-service-grm-014',
        'hk-service-grm-015',
        'hk-service-grm-016',
        'hk-service-grm-017',
        'hk-service-grm-018',
        'hk-service-grm-019',
        'hk-service-grm-020',
        'hk-service-grm-021',
        'hk-service-grm-022',
        'hk-service-grm-023',
        'hk-service-grm-024',
        'hk-service-grm-025',
        'hk-service-grm-026',
        'hk-service-grm-027',
        'hk-service-grm-028',
        'hk-service-grm-035',
        'hk-service-grm-036',
        'hk-service-grm-037',
        'hk-service-grm-038',
        'hk-service-grm-039',
        'hk-service-grm-040',
        'hk-service-grm-041',
        'hk-service-grm-042',
        'hk-service-grm-043',
        'hk-service-grm-044',
        'hk-service-grm-045',
        'hk-service-grm-046',
        'hk-service-grm-047',
        'hk-service-grm-048',
        'hk-service-grm-049',
        'hk-service-grm-050',
        'hk-service-grm-051',
        'hk-service-grm-052',
        'hk-service-grm-053',
        'hk-service-grm-054',
        'hk-service-grm-055',
        'hk-service-grm-056',
        'hk-service-fun-001',
        'hk-service-fun-002',
        'hk-service-fun-003',
        'hk-service-fun-004',
        'hk-service-fun-005',
        'hk-service-fun-006',
        'hk-service-fun-007',
        'hk-service-fun-008',
        'hk-service-fun-009',
        'hk-service-fun-010',
        'hk-service-fun-011',
        'hk-service-fun-012',
        'hk-service-fun-013',
        'hk-service-fun-014',
        'hk-service-fun-015',
        'hk-service-fun-016',
        'hk-service-fun-017',
        'hk-service-fun-018',
        'hk-service-fun-019',
        'hk-service-fun-020',
        'hk-service-fun-021',
        'hk-service-fun-022',
        'hk-service-fun-023',
        'hk-service-fun-024',
        'insurance-hk-fwd',
        'insurance-hk-onedegree',
        'insurance-hk-bluecross'
      ];
    }

    function validUserSavedLists(data) {
      return data.favoriteClinics is list
        && data.favoriteClinics.size() <= 200
        && data.savedProducts is list
        && data.savedProducts.size() <= 200
        && data.savedProducts.hasOnly(allowedSavedCatalogItemIDs())
        && data.savedProducts.toSet().size() == data.savedProducts.size();
    }

    function validUserSavedListsUpdate(after, before) {
      let afterFavorites = after.get('favoriteClinics', null);
      let beforeFavorites = before.get('favoriteClinics', null);
      let afterSaved = after.get('savedProducts', null);
      let beforeSaved = before.get('savedProducts', null);
      let afterHasFavorites = 'favoriteClinics' in after;
      let beforeHasFavorites = 'favoriteClinics' in before;
      let afterHasSaved = 'savedProducts' in after;
      let beforeHasSaved = 'savedProducts' in before;
      return (
          (
            afterHasFavorites == beforeHasFavorites
            && afterFavorites == beforeFavorites
          )
          || (
            afterHasFavorites
            && afterFavorites is list
            && afterFavorites.size() <= 200
          )
        )
        && (
          (
            afterHasSaved == beforeHasSaved
            && afterSaved == beforeSaved
          )
          || (
            afterHasSaved
            && afterSaved is list
            && afterSaved.size() <= 200
            && (
              (
                afterSaved.hasOnly(allowedSavedCatalogItemIDs())
                && afterSaved.toSet().size() == afterSaved.size()
              )
              || (
                beforeSaved is list
                && afterSaved.size() - afterSaved.toSet().size()
                  <= beforeSaved.size() - beforeSaved.toSet().size()
                && afterSaved.toSet()
                  .difference(beforeSaved.toSet())
                  .hasOnly(allowedSavedCatalogItemIDs())
              )
            )
          )
        );
    }

    function validConversation(data, conversationId) {
      return data.keys().hasAll([
          'id', 'participantIds', 'participantNames', 'lastMessageId',
          'lastMessage', 'lastMessageAt', 'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'participantIds', 'participantNames', 'lastMessageId',
          'lastMessage', 'lastMessageAt', 'lastSenderId', 'createdAt', 'updatedAt',
          'sourceReviewId'
        ])
        && data.id == conversationId
        && data.participantIds is list
        && data.participantIds.size() == 2
        && validChatUserID(data.participantIds[0])
        && validChatUserID(data.participantIds[1])
        && data.participantIds[0] != data.participantIds[1]
        && data.participantIds[0] < data.participantIds[1]
        && conversationId.size() <= 200
        && conversationId
          == data.participantIds[0] + '--' + data.participantIds[1]
        && data.participantNames is map
        && data.participantNames.keys().hasAll(data.participantIds)
        && data.participantNames.keys().hasOnly(data.participantIds)
        && data.participantNames[data.participantIds[0]] is string
        && data.participantNames[data.participantIds[0]].size() > 0
        && data.participantNames[data.participantIds[0]].size() <= 80
        && data.participantNames[data.participantIds[1]] is string
        && data.participantNames[data.participantIds[1]].size() > 0
        && data.participantNames[data.participantIds[1]].size() <= 80
        && (!('sourceReviewId' in data) || validDocumentID(data.sourceReviewId))
        && validDocumentID(data.lastMessageId)
        && data.lastMessage is string
        && data.lastMessage.size() > 0
        && data.lastMessage.size() <= 1000
        && data.lastSenderId in data.participantIds
        && recentClientTimestamp(data.lastMessageAt)
        && notFutureTimestamp(data.createdAt)
        && recentClientTimestamp(data.updatedAt)
        && data.lastMessageAt == data.updatedAt;
    }

    function chatParticipant(data) {
      return signedIn()
        && request.auth.uid in data.participantIds;
    }

    function pendingMessageReportAfter(conversationId, messageId) {
      let reportId = 'message-' + messageId + '-' + request.auth.uid;
      return signedIn()
        && existsAfter(
          /databases/$(database)/documents/reports/$(reportId)
        )
        && getAfter(
          /databases/$(database)/documents/reports/$(reportId)
        ).data.id == reportId
        && getAfter(
          /databases/$(database)/documents/reports/$(reportId)
        ).data.targetType == 'message'
        && getAfter(
          /databases/$(database)/documents/reports/$(reportId)
        ).data.targetId == messageId
        && getAfter(
          /databases/$(database)/documents/reports/$(reportId)
        ).data.conversationId == conversationId
        && getAfter(
          /databases/$(database)/documents/reports/$(reportId)
        ).data.reporterId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/reports/$(reportId)
        ).data.status == 'pending';
    }

    function reportedConversation(conversationId) {
      return exists(
        /databases/$(database)/documents/chatModeration/$(conversationId)
      );
    }

    function reportedMessage(conversationId, messageId) {
      return exists(
        /databases/$(database)/documents/chatModeration/$(conversationId)/reportedMessages/$(messageId)
      );
    }

    function chatUnblocked(data) {
      return !exists(
          /databases/$(database)/documents/users/$(data.participantIds[0])/blockedUsers/$(data.participantIds[1])
        )
        && !exists(
          /databases/$(database)/documents/users/$(data.participantIds[1])/blockedUsers/$(data.participantIds[0])
        );
    }

    function approvedChatOrigin(data) {
      let sourceStateId = 'review-' + data.sourceReviewId;
      return 'sourceReviewId' in data
        && validDocumentID(data.sourceReviewId)
        && exists(
          /databases/$(database)/documents/reviews/$(data.sourceReviewId)
        )
        && get(
          /databases/$(database)/documents/reviews/$(data.sourceReviewId)
        ).data.status == 'approved'
        && get(
          /databases/$(database)/documents/reviews/$(data.sourceReviewId)
        ).data.userId in data.participantIds
        && (
          !exists(
            /databases/$(database)/documents/contentStates/$(sourceStateId)
          )
          || get(
            /databases/$(database)/documents/contentStates/$(sourceStateId)
          ).data.isRemoved == false
        );
    }

    function validChatMessage(data, conversationId, messageId) {
      return data.keys().hasAll([
          'id', 'conversationId', 'senderId', 'body', 'sentAt', 'isDeleted'
        ])
        && data.keys().hasOnly([
          'id', 'conversationId', 'senderId', 'body', 'sentAt', 'isDeleted',
          'deletedAt', 'deletedBy'
        ])
        && data.id == messageId
        && validDocumentID(data.id)
        && data.conversationId == conversationId
        && data.senderId == request.auth.uid
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 1000
        && recentClientTimestamp(data.sentAt)
        && data.isDeleted == false
        && !('deletedAt' in data)
        && !('deletedBy' in data);
    }

    function currentHKCatalogDocument(data) {
      return data.status == 'approved'
        && data.catalogRegion == 'HK'
        && data.region == 'HK'
        && data.expiresAt is timestamp
        && data.expiresAt > request.time;
    }

    function validClinic(data) {
      return data.keys().hasAll([
          'id', 'name', 'address', 'coordinate', 'phone', 'openingHours',
          'services', 'avgRating', 'reviewCount', 'priceLevel', 'images',
          'tags', 'createdAt', 'updatedAt', 'reportedBy', 'verified'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'address', 'coordinate', 'phone', 'website',
          'openingHours', 'services', 'avgRating', 'reviewCount', 'priceLevel',
          'images', 'tags', 'createdAt', 'updatedAt', 'reportedBy', 'verified',
          'authorId', 'status', 'approvedAt', 'catalogRegion', 'migrationId'
        ])
        && validDocumentID(data.id)
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.address is string
        && data.address.size() > 0
        && data.address.size() <= 500
        && data.coordinate is map
        && data.coordinate.keys().hasAll(['latitude', 'longitude'])
        && data.coordinate.keys().hasOnly(['latitude', 'longitude'])
        && data.coordinate.latitude is number
        && data.coordinate.latitude >= 22.1
        && data.coordinate.latitude <= 22.6
        && data.coordinate.longitude is number
        && data.coordinate.longitude >= 113.8
        && data.coordinate.longitude <= 114.5
        && data.phone is string
        && (!('website' in data) || data.website is string)
        && data.openingHours is map
        && data.services is list
        && data.images is list
        && data.tags is list
        && data.avgRating is number
        && data.reviewCount is int
        && data.reviewCount >= 0
        && data.priceLevel is int
        && data.priceLevel >= 0
        && data.priceLevel <= 3
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.reportedBy is string
        && data.verified is bool
        && (!('catalogRegion' in data) || data.catalogRegion == 'HK')
        && (!('migrationId' in data) || data.migrationId is string);
    }

    // Admin approval is not independent verification of operating, reputation,
    // price, media, or taxonomy claims supplied by a user. Every client-source
    // clinic publication must contain only the safe server projection.
    function safeClinicPublication(data) {
      return data.catalogRegion == 'HK'
        && data.reportedBy == data.authorId
        && data.verified == false
        && data.openingHours.size() == 0
        && !('availability' in data)
        && data.services.size() == 0
        && data.avgRating == 0
        && data.reviewCount == 0
        && data.priceLevel == 0
        && data.images.size() == 0
        && data.tags.size() == 0;
    }

    function validReview(data) {
      return data.keys().hasAll([
          'id', 'clinicId', 'userId', 'userName', 'rating', 'title', 'content',
          'createdAt', 'updatedAt', 'helpfulCount'
        ])
        && data.keys().hasOnly([
          'id', 'clinicId', 'userId', 'userName', 'rating', 'title', 'content',
          'treatmentType', 'cost', 'images', 'createdAt', 'updatedAt',
          'helpfulCount', 'authorId', 'status', 'approvedAt'
        ])
        && validDocumentID(data.id)
        && validDocumentID(data.clinicId)
        && validDocumentID(data.userId)
        && data.userName is string
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 4000
        && (!('treatmentType' in data) || data.treatmentType is string)
        && (!('cost' in data) || data.cost is number)
        && (!('images' in data) || data.images is list)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.helpfulCount is int
        && data.helpfulCount >= 0;
    }

    function validQuote(data) {
      return data.keys().hasAll([
          'id', 'clinicId', 'userId', 'treatmentType', 'estimatedCost',
          'currency', 'notes', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'clinicId', 'userId', 'treatmentType', 'estimatedCost',
          'actualCost', 'currency', 'notes', 'createdAt',
          'authorId', 'status', 'approvedAt'
        ])
        && validDocumentID(data.id)
        && validDocumentID(data.clinicId)
        && validDocumentID(data.userId)
        && data.treatmentType is string
        && data.treatmentType.size() > 0
        && data.treatmentType.size() <= 200
        && data.estimatedCost is number
        && data.estimatedCost > 0
        && (!('actualCost' in data) || data.actualCost is number)
        && data.currency in ['TWD', 'HKD']
        && data.notes is string
        && data.notes.size() <= 4000
        && data.createdAt is timestamp;
    }

    function validSubmission(data, submissionId) {
      return data.keys().hasAll([
          'id', 'type', 'authorId', 'authorName', 'status', 'submittedAt'
        ])
        && data.keys().hasOnly([
          'id', 'type', 'authorId', 'authorName', 'status', 'submittedAt',
          'clinicName', 'clinic', 'review', 'quote', 'reviewedAt', 'reviewedBy'
        ])
        && data.id == submissionId
        && validDocumentID(data.id)
        && data.type in ['clinic', 'review', 'quote']
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 200
        && data.status == 'pending'
        && recentClientTimestamp(data.submittedAt)
        && !('reviewedAt' in data)
        && !('reviewedBy' in data)
        && (
          (data.type == 'clinic'
            && data.keys().hasAll(['clinic'])
            && !('review' in data)
            && !('quote' in data)
            && validClinic(data.clinic)
            && !('authorId' in data.clinic)
            && !('status' in data.clinic)
            && !('approvedAt' in data.clinic)
            && !('catalogRegion' in data.clinic)
            && !('migrationId' in data.clinic)
            && data.clinic.reportedBy == request.auth.uid
            && data.clinic.verified == false
            && data.clinic.avgRating == 0
            && data.clinic.reviewCount == 0
            && notFutureTimestamp(data.clinic.createdAt)
            && notFutureTimestamp(data.clinic.updatedAt)
            && data.clinic.updatedAt >= data.clinic.createdAt)
          ||
          (data.type == 'review'
            && data.keys().hasAll(['review', 'clinicName'])
            && !('clinic' in data)
            && !('quote' in data)
            && data.clinicName is string
            && validReview(data.review)
            && !('authorId' in data.review)
            && !('status' in data.review)
            && !('approvedAt' in data.review)
            && data.review.userId == request.auth.uid
            && data.review.helpfulCount == 0
            && notFutureTimestamp(data.review.createdAt)
            && notFutureTimestamp(data.review.updatedAt)
            && data.review.updatedAt >= data.review.createdAt)
          ||
          (data.type == 'quote'
            && data.keys().hasAll(['quote', 'clinicName'])
            && !('clinic' in data)
            && !('review' in data)
            && data.clinicName is string
            && validQuote(data.quote)
            && !('authorId' in data.quote)
            && !('status' in data.quote)
            && !('approvedAt' in data.quote)
            && data.quote.userId == request.auth.uid
            && notFutureTimestamp(data.quote.createdAt))
        );
    }

    // Public content can only be published by an admin after queue approval.
    match /clinics/{clinicId} {
      allow read: if resource.data.status == 'approved' || admin();
      allow create: if admin()
        && request.resource.data.id == clinicId
        && validClinic(request.resource.data)
        && request.resource.data.keys().hasAll(['authorId', 'status', 'approvedAt'])
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'address', 'coordinate', 'phone', 'website',
          'openingHours', 'services', 'avgRating', 'reviewCount', 'priceLevel',
          'images', 'tags', 'createdAt', 'updatedAt', 'reportedBy', 'verified',
          'authorId', 'status', 'approvedAt', 'catalogRegion', 'migrationId'
        ])
        && safeClinicPublication(request.resource.data)
        && request.resource.data.authorId is string
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedAt is timestamp;
      // Queue approval is create-only. This prevents a crafted submission ID
      // from overwriting an existing curated or previously approved clinic.
      allow update: if false;
      allow delete: if admin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || admin();
      allow create: if admin()
        && request.resource.data.id == reviewId
        && validReview(request.resource.data)
        && request.resource.data.keys().hasAll(['authorId', 'status', 'approvedAt'])
        && request.resource.data.keys().hasOnly([
          'id', 'clinicId', 'userId', 'userName', 'rating', 'title', 'content',
          'treatmentType', 'cost', 'images', 'createdAt', 'updatedAt',
          'helpfulCount', 'authorId', 'status', 'approvedAt'
        ])
        && request.resource.data.authorId == request.resource.data.userId
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedAt is timestamp;
      allow update: if false;
      allow delete: if admin();
    }

    // Helpful votes live separately so both bundled seed reviews and cloud
    // reviews support one durable vote per Firebase UID.
    match /reviewEngagement/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && validDocumentID(reviewId)
        && request.resource.data.keys().hasAll([
          'reviewId', 'helpfulCount', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'reviewId', 'helpfulCount', 'updatedAt'
        ])
        && request.resource.data.reviewId == reviewId
        && request.resource.data.helpfulCount == 1
        && request.resource.data.updatedAt == request.time
        && !exists(
          /databases/$(database)/documents/reviewEngagement/$(reviewId)/voters/$(request.auth.uid)
        )
        && existsAfter(
          /databases/$(database)/documents/reviewEngagement/$(reviewId)/voters/$(request.auth.uid)
        );
      allow update: if signedIn()
        && request.resource.data.reviewId == resource.data.reviewId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['helpfulCount', 'updatedAt'])
        && request.resource.data.helpfulCount == resource.data.helpfulCount + 1
        && request.resource.data.updatedAt == request.time
        && !exists(
          /databases/$(database)/documents/reviewEngagement/$(reviewId)/voters/$(request.auth.uid)
        )
        && existsAfter(
          /databases/$(database)/documents/reviewEngagement/$(reviewId)/voters/$(request.auth.uid)
        );
      allow delete: if admin();

      match /voters/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || admin());
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['userId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == userId
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if admin();
      }
    }

    match /quotes/{quoteId} {
      allow read: if resource.data.status == 'approved' || admin();
      allow create: if admin()
        && request.resource.data.id == quoteId
        && validQuote(request.resource.data)
        && request.resource.data.keys().hasAll(['authorId', 'status', 'approvedAt'])
        && request.resource.data.keys().hasOnly([
          'id', 'clinicId', 'userId', 'treatmentType', 'estimatedCost',
          'actualCost', 'currency', 'notes', 'createdAt',
          'authorId', 'status', 'approvedAt'
        ])
        && request.resource.data.authorId == request.resource.data.userId
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedAt is timestamp;
      allow update: if false;
      allow delete: if admin();
    }

    match /conversations/{conversationId} {
      allow read: if chatParticipant(resource.data)
        || (admin() && reportedConversation(conversationId));
      allow create: if signedIn()
        && validConversation(request.resource.data, conversationId)
        && recentClientTimestamp(request.resource.data.createdAt)
        && chatParticipant(request.resource.data)
        && chatUnblocked(request.resource.data)
        && approvedChatOrigin(request.resource.data)
        && get(
          /databases/$(database)/documents/reviews/$(request.resource.data.sourceReviewId)
        ).data.userId != request.auth.uid
        && existsAfter(
          /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)
        )
        && getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)
        ).data.body == request.resource.data.lastMessage
        && getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)
        ).data.senderId == request.auth.uid;
      allow update: if (
          (admin()
            || (chatParticipant(resource.data) && chatUnblocked(resource.data)))
          && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessageId', 'lastMessage', 'lastMessageAt',
              'lastSenderId', 'updatedAt'
            ])
            && validConversation(request.resource.data, conversationId)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.participantIds == resource.data.participantIds
            && request.resource.data.participantNames == resource.data.participantNames
            && request.resource.data.lastSenderId == request.auth.uid
            && existsAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)
            )
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)
            ).data.body == request.resource.data.lastMessage
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)
            ).data.senderId == request.auth.uid
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage'])
            && request.resource.data.lastMessage == '訊息已刪除'
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(resource.data.lastMessageId)
            ).data.isDeleted == true
            && getAfter(
              /databases/$(database)/documents/conversations/$(conversationId)/messages/$(resource.data.lastMessageId)
            ).data.deletedBy == request.auth.uid
          )
          )
        )
        || (
          admin()
          && !('sourceReviewId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sourceReviewId'])
          && approvedChatOrigin(request.resource.data)
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          ) || (admin() && reportedMessage(conversationId, messageId));
        allow create: if signedIn()
          && existsAfter(/databases/$(database)/documents/conversations/$(conversationId))
          && chatParticipant(
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          && chatUnblocked(
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          && validChatMessage(request.resource.data, conversationId, messageId)
          && getAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.lastMessageId == messageId
          && getAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.lastMessage == request.resource.data.body
          && getAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.lastSenderId == request.auth.uid;
        allow update: if (
            (admin() && reportedMessage(conversationId, messageId))
            || (
              chatParticipant(
                get(/databases/$(database)/documents/conversations/$(conversationId)).data
              )
              && resource.data.senderId == request.auth.uid
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'body', 'isDeleted', 'deletedAt', 'deletedBy'
          ])
          && resource.data.isDeleted == false
          && request.resource.data.body == ''
          && request.resource.data.isDeleted == true
          && request.resource.data.deletedAt == request.time
          && request.resource.data.deletedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    // A message report and both moderation markers must be written in the same
    // atomic batch. The conversation marker reveals only conversation metadata
    // to an admin; the nested marker authorizes access to that one message.
    match /chatModeration/{conversationId} {
      allow read: if admin();
      allow create: if signedIn()
        && validDocumentID(conversationId)
        && exists(
          /databases/$(database)/documents/conversations/$(conversationId)
        )
        && chatParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        )
        && request.resource.data.keys().hasAll([
          'conversationId', 'lastReportedMessageId', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'conversationId', 'lastReportedMessageId', 'updatedAt'
        ])
        && request.resource.data.conversationId == conversationId
        && validDocumentID(request.resource.data.lastReportedMessageId)
        && request.resource.data.updatedAt == request.time
        && pendingMessageReportAfter(
          conversationId,
          request.resource.data.lastReportedMessageId
        );
      allow update: if signedIn()
        && chatParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastReportedMessageId', 'updatedAt'
        ])
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.conversationId == conversationId
        && validDocumentID(request.resource.data.lastReportedMessageId)
        && request.resource.data.updatedAt == request.time
        && pendingMessageReportAfter(
          conversationId,
          request.resource.data.lastReportedMessageId
        );
      allow delete: if admin();

      match /reportedMessages/{messageId} {
        allow read: if admin();
        allow create: if signedIn()
          && validDocumentID(messageId)
          && exists(
            /databases/$(database)/documents/conversations/$(conversationId)
          )
          && chatParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          && exists(
            /databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)
          )
          && request.resource.data.keys().hasAll([
            'conversationId', 'messageId', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'conversationId', 'messageId', 'updatedAt'
          ])
          && request.resource.data.conversationId == conversationId
          && request.resource.data.messageId == messageId
          && request.resource.data.updatedAt == request.time
          && pendingMessageReportAfter(conversationId, messageId);
        allow update: if signedIn()
          && chatParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['updatedAt'])
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.conversationId == conversationId
          && request.resource.data.messageId == resource.data.messageId
          && request.resource.data.messageId == messageId
          && request.resource.data.updatedAt == request.time
          && pendingMessageReportAfter(conversationId, messageId);
        allow delete: if admin();
      }
    }

    match /submissions/{submissionId} {
      allow create: if signedIn() && validSubmission(request.resource.data, submissionId);
      allow read: if admin()
        || (signedIn() && resource.data.authorId == request.auth.uid);
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if admin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'id', 'targetType', 'targetId', 'targetTitle', 'reason',
          'reporterId', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'targetType', 'targetId', 'targetTitle', 'clinicId', 'conversationId',
          'reason', 'reporterId', 'createdAt', 'status',
          'resolvedAt', 'resolvedBy'
        ])
        && request.resource.data.id == reportId
        && validDocumentID(request.resource.data.id)
        && request.resource.data.targetType in ['clinic', 'review', 'quote', 'message']
        && validDocumentID(request.resource.data.targetId)
        && request.resource.data.targetTitle is string
        && request.resource.data.targetTitle.size() > 0
        && request.resource.data.targetTitle.size() <= 200
        && request.resource.data.id
          == request.resource.data.targetType + '-'
            + request.resource.data.targetId + '-' + request.auth.uid
        && (
          !('clinicId' in request.resource.data)
          || validDocumentID(request.resource.data.clinicId)
        )
        && (
          (request.resource.data.targetType == 'message'
            && 'conversationId' in request.resource.data
            && request.resource.data.conversationId is string
            && request.resource.data.conversationId.size() > 0
            && request.resource.data.conversationId.size() <= 200
            && exists(
              /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
            )
            && chatParticipant(
              get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data
            )
            && exists(
              /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)/messages/$(request.resource.data.targetId)
            )
            && existsAfter(
              /databases/$(database)/documents/chatModeration/$(request.resource.data.conversationId)
            )
            && getAfter(
              /databases/$(database)/documents/chatModeration/$(request.resource.data.conversationId)
            ).data.lastReportedMessageId == request.resource.data.targetId
            && existsAfter(
              /databases/$(database)/documents/chatModeration/$(request.resource.data.conversationId)/reportedMessages/$(request.resource.data.targetId)
            ))
          || (request.resource.data.targetType != 'message'
            && !('conversationId' in request.resource.data))
        )
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.reporterId == request.auth.uid
        && recentClientTimestamp(request.resource.data.createdAt)
        && request.resource.data.status == 'pending'
        && !('resolvedAt' in request.resource.data)
        && !('resolvedBy' in request.resource.data);
      allow read: if admin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if admin();
    }

    // Public state also hides bundled seed records after a moderator take-down.
    match /contentStates/{stateId} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasAll([
          'id', 'type', 'targetId', 'isRemoved', 'isPinned',
          'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'type', 'targetId', 'isRemoved', 'isPinned',
          'updatedAt', 'updatedBy'
        ])
        && request.resource.data.id == stateId
        && validDocumentID(request.resource.data.id)
        && request.resource.data.type in ['clinic', 'review', 'quote']
        && validDocumentID(request.resource.data.targetId)
        && request.resource.data.isRemoved is bool
        && request.resource.data.isPinned is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if admin();
    }

    match /products/{productId} {
      allow read: if admin() || currentHKCatalogDocument(resource.data);
      allow write: if admin();
    }

    match /insurances/{insuranceId} {
      allow read: if admin() || currentHKCatalogDocument(resource.data);
      allow write: if admin();
    }

    // User records are private. Public UGC carries a display name, never a
    // readable user profile document.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'providerIDs', 'createdAt',
          'updatedAt', 'isPremium', 'favoriteClinics', 'savedProducts'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'providerIDs', 'createdAt',
          'updatedAt', 'isPremium', 'favoriteClinics', 'savedProducts'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.isPremium == false
        && validUserSavedLists(request.resource.data);
      allow update: if admin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'email', 'providerIDs', 'createdAt',
            'updatedAt', 'isPremium', 'favoriteClinics', 'savedProducts', 'role'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'email', 'providerIDs', 'updatedAt',
            'favoriteClinics', 'savedProducts'
          ])
          && validUserSavedListsUpdate(request.resource.data, resource.data)
        );
      allow delete: if signedIn() && (request.auth.uid == userId || admin());

      match /blockedUsers/{blockedUserId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && blockedUserId != request.auth.uid
          && request.resource.data.keys().hasAll(['blockedUserId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['blockedUserId', 'createdAt'])
          && request.resource.data.blockedUserId == blockedUserId
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
